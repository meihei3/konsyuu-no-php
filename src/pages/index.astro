---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const description = 'php.internals の過去1週間の議論を、RFCに限らず日本語で噛み砕いてまとめる週次レポート。';
---

<BaseLayout title="今週のPHP internals" description={description}>
  <h1>今週のPHP internals</h1>
  <p class="lead">{description}各記事は「要約・噛み砕いた説明・感想」の3点で構成しています。</p>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}posts/${post.id.replace(/\.md$/, '')}/`}>
            {post.data.title}
          </a>
          <span class="meta">
            {' '}
            — {post.data.pubDate.toISOString().slice(0, 10)}
          </span>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
