---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const description = 'php.internals の過去1週間の議論を、RFCに限らず日本語で噛み砕いてまとめる週次レポート。';
const origin = (Astro.site?.toString() ?? '').replace(/\/$/, '');
---

<BaseLayout title="今週のPHP（Re）" description={description}>
  <h1>今週のPHP（Re）</h1>
  <p class="lead">{description}各記事は「要約・噛み砕いた説明・感想」の3点で構成しています。</p>
  <h2>記事一覧</h2>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}posts/${post.id.replace(/\.md$/, '')}/`}>
            {post.data.title}
          </a>
          <span class="meta">
            {' '}
            — {post.data.pubDate.toISOString().slice(0, 10)}
          </span>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
  <p><a href={`${import.meta.env.BASE_URL}posts/`}>記事をもっと見る →</a></p>
  <h2>RSS と AI 向けファイル</h2>
  <p>このサイトは、RSS リーダーや AI アシスタントからも読めます。</p>
  <ul>
    <li>
      RSS（新着記事の購読）: <a href={`${import.meta.env.BASE_URL}rss.xml`}>{origin}/rss.xml</a>
      <br />RSS リーダーにこの URL を登録すると、新しい記事が届きます。
    </li>
    <li>
      llms.txt（AI 向けの記事一覧）: <a href={`${import.meta.env.BASE_URL}llms.txt`}>{origin}/llms.txt</a>
      <br />AI アシスタントにこの URL を渡すと、記事の一覧と概要を読ませることができます。
    </li>
    <li>
      llms-full.txt（AI 向けの全文）: <a href={`${import.meta.env.BASE_URL}llms-full.txt`}>{origin}/llms-full.txt</a>
      <br />全記事の全文が入った版です。
    </li>
  </ul>
</BaseLayout>
