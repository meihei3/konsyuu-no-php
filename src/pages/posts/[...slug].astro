---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const shareUrl = `${Astro.site?.toString().replace(/\/$/, '') ?? ''}${import.meta.env.BASE_URL}posts/${post.id.replace(/\.md$/, '')}/`;
const shareLinks = [
  { label: 'X', href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(shareUrl)}` },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`posts/${post.id.replace(/\.md$/, '')}/`}
  pubDate={post.data.pubDate}
  type="article"
>
  <p class="meta">{post.data.pubDate.toISOString().slice(0, 10)}</p>
  <h1>{post.data.title}</h1>
  <p class="lead">{post.data.description}</p>
  <div class="post-body">
    <Content />
  </div>
  <div class="share">
    <span class="share-label">シェア</span>
    {
      shareLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label}
        </a>
      ))
    }
    <button type="button" id="copy-link">リンクをコピー</button>
  </div>
  <script>
    const btn = document.getElementById('copy-link');
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const original = btn.textContent;
        btn.textContent = 'コピーしました';
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      } catch {
        // クリップボードが使えない環境では何もしない
      }
    });
  </script>
  <style is:global>
    /* internals (externals.io) へのリンクは externals.io 本文リンクの赤 #e7000b。
       訪問済みは少し薄く、hover は少し濃く (Ema の指定 2026-11-18)。
       Markdown 生成のリンクにも届くよう、この style は is:global が必須。 */
    .post-body a[href*='externals.io'] {
      color: #e7000b;
    }
    .post-body a[href*='externals.io']:visited {
      color: #ef5960;
    }
    .post-body a[href*='externals.io']:hover {
      color: #b90009;
    }
    .share {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin-top: 3rem;
      font-size: 0.85rem;
    }
    .share-label {
      color: #666;
      margin-right: 0.25rem;
    }
    .share a,
    .share button {
      color: #555;
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 999px;
      padding: 0.25rem 0.8rem;
      text-decoration: none;
      font: inherit;
      cursor: pointer;
      line-height: 1.6;
    }
    .share a:hover,
    .share button:hover {
      border-color: #999;
      color: #1a1a1a;
    }
  </style>
</BaseLayout>
