---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pubDate?: Date;
  tags?: string[];
  type?: 'website' | 'article';
}

const { title, description, canonicalPath = '', pubDate, tags = [], type = 'website' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${site}${import.meta.env.BASE_URL}${canonicalPath}`.replace(/([^:]\/)\/+/g, '$1');
const ogImage = `${site}${import.meta.env.BASE_URL}og.png?v=1`.replace(/([^:]\/)\/+/g, '$1');
const siteRoot = `${site}${import.meta.env.BASE_URL}`;
const siteDescription = 'php.internals の過去1週間の議論を、RFCに限らず日本語で噛み砕いてまとめる週次レポート。';
const organization = {
  '@type': 'Organization',
  '@id': `${siteRoot}#organization`,
  name: '今週のPHP（Re）',
  url: siteRoot,
  logo: { '@type': 'ImageObject', url: `${siteRoot}favicon.png` },
};
const blog = {
  '@type': 'Blog',
  '@id': `${siteRoot}#blog`,
  name: '今週のPHP（Re）',
  url: siteRoot,
  description: siteDescription,
  inLanguage: 'ja',
  publisher: { '@id': `${siteRoot}#organization` },
};
const graph: Record<string, unknown>[] = [organization, blog];
if (type === 'article' && pubDate) {
  graph.push(
    {
      '@type': 'BlogPosting',
      '@id': `${canonical}#article`,
      headline: title,
      description,
      inLanguage: 'ja',
      datePublished: pubDate.toISOString(),
      dateModified: pubDate.toISOString(),
      image: `${siteRoot}og.png`,
      author: { '@id': `${siteRoot}#organization` },
      publisher: { '@id': `${siteRoot}#organization` },
      isPartOf: { '@id': `${siteRoot}#blog` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'トップ', item: siteRoot },
        { '@type': 'ListItem', position: 2, name: '記事一覧', item: `${siteRoot}posts/` },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    },
  );
} else {
  graph.push({
    '@type': 'WebSite',
    '@id': `${siteRoot}#website`,
    name: '今週のPHP（Re）',
    url: siteRoot,
    description: siteDescription,
    inLanguage: 'ja',
    publisher: { '@id': `${siteRoot}#organization` },
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="今週のPHP（Re）" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="今週のPHP（Re）" href={`${import.meta.env.BASE_URL}rss.xml`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      body { font-family: "Noto Sans JP", system-ui, -apple-system, "Hiragino Kaku Gothic ProN", sans-serif; line-height: 1.8; max-width: 720px; margin: 0 auto; padding: 2rem 1.25rem; color: #1a1a1a; }
      a { color: #1a1a1a; }
      a:visited { color: #8a8a8a; }
      a:hover { color: #333; }
      h1 { font-size: 1.6rem; line-height: 1.4; }
      h2 { font-size: 1.25rem; margin-top: 2.5rem; border-bottom: 1px solid #ddd; padding-bottom: 0.25rem; }
      .lead { background: #f5f5f5; padding: 1rem; }
      .meta { color: #666; font-size: 0.9rem; }
      header a, footer a { text-decoration: none; }
    </style>
  </head>
  <body>
    <header><a href={import.meta.env.BASE_URL}>今週のPHP（Re）</a></header>
    <main><slot /></main>
    <footer>
      <hr />
      <p class="meta"><a href={`${import.meta.env.BASE_URL}about/`}>このサイトについて</a></p>
      <p class="meta">php.internals の週次レポート。情報源は <a href="https://externals.io/">externals.io</a> と <a href="https://wiki.php.net/rfc">wiki.php.net/rfc</a>。</p>
      <p class="meta">このサイトの記事は、感想を含め AI アシスタント Muse が作成したもので、運営者個人の見解ではありません。</p>
    </footer>
  </body>
</html>
