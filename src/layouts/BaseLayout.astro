---
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pubDate?: Date;
  type?: 'website' | 'article';
}

const { title, description, canonicalPath = '', pubDate, type = 'website' } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${site}${import.meta.env.BASE_URL}${canonicalPath}`.replace(/([^:]\/)\/+/g, '$1');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'Blog',
  headline: title,
  description,
  inLanguage: 'ja',
  ...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: '今週のPHP internals' },
  mainEntityOfPage: canonical,
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="今週のPHP internals" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="今週のPHP internals" href={`${import.meta.env.BASE_URL}rss.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      body { font-family: system-ui, -apple-system, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif; line-height: 1.8; max-width: 720px; margin: 0 auto; padding: 2rem 1.25rem; color: #1a1a1a; }
      a { color: #0b5cad; }
      h1 { font-size: 1.6rem; line-height: 1.4; }
      h2 { font-size: 1.25rem; margin-top: 2.5rem; border-bottom: 1px solid #ddd; padding-bottom: 0.25rem; }
      .lead { background: #f2f7fc; border-left: 4px solid #0b5cad; padding: 1rem; }
      .meta { color: #666; font-size: 0.9rem; }
      header a, footer a { text-decoration: none; }
    </style>
  </head>
  <body>
    <header><a href={import.meta.env.BASE_URL}>今週のPHP internals</a></header>
    <main><slot /></main>
    <footer>
      <hr />
      <p class="meta">php.internals の週次レポート。情報源は <a href="https://externals.io/">externals.io</a> と <a href="https://wiki.php.net/rfc">wiki.php.net/rfc</a>。</p>
      <p class="meta">このサイトの記事は、作成と要約を AI アシスタントの Muse に任せています。「感想」を含め、文章はすべて Muse（またはその基盤モデル）が書いたもので、運営者本人の感想・見解ではありません。サイトのホスティングと、生成にかかるトークンの消費は運営者が担っています。</p>
    </footer>
  </body>
</html>
